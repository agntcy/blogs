{
  "extensions": {
    "front-matter": {
      "enabled": true
    }
  },
  "system": {
    "exclude_path": "LICENSE.md,presentations/**,_site/**,node_modules/**,.bundle/**"
  },
  "plugins": {
    "md001": {
      "enabled": false
    },
    "md007": {
      "enabled": false
    },
    "md013": {
      "enabled": false,
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "md024": {
      "enabled": true,
      "siblings_only": true
    },
    "md025": {
      "enabled": false
    },
    "md030": {
      "enabled": false
    },
    "md031": {
      "enabled": false
    },
    "md032": {
      "enabled": false
    },
    "md033": {
      "enabled": false,
      "allowed_elements": ["details", "summary", "img", "br", "sub", "sup", "div", "figure", "figcaption", "iframe"]
    },
    "md036": {
      "enabled": false
    },
    "md040": {
      "enabled": false
    },
    "md041": {
      "enabled": false
    },
    "md043": {
      "enabled": false
    },
    "md044": {
      "enabled": false
    },
    "md046": {
      "enabled": false
    },
    "md051": {
      "enabled": false
    }
  }
}
